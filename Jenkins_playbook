# Installation commands
1.
sudo apt update
sudo apt install openjdk-21-jre

2.
sudo wget -O /usr/share/keyrings/jenkins-keyring.asc \
  https://pkg.jenkins.io/debian-stable/jenkins.io-2026.key
3.
echo "deb [signed-by=/usr/share/keyrings/jenkins-keyring.asc] https://pkg.jenkins.io/debian-stable binary/" \
  | sudo tee /etc/apt/sources.list.d/jenkins.list > /dev/null

4.
sudo apt update
sudo apt install jenkins

5.
#Start Jenkins commands
sudo systemctl enable jenkins
sudo systemctl start jenkins

6.
sudo cat /var/lib/jenkins/secrets/initialAdminPassword

#Move tmp from ram to disk
1.
sudo mkdir -p /etc/systemd/system/jenkins.service.d

2.
sudo nano /etc/systemd/system/jenkins.service.d/override.conf

3. # Paste in editor
[Service]
Environment="JAVA_OPTS=-Djava.io.tmpdir=/var/lib/jenkins/tmp"

4. #Give permissions to override
sudo mkdir -p /var/lib/jenkins/tmp
sudo chown -R jenkins:jenkins /var/lib/jenkins/tmp

5. 
sudo systemctl reset-failed jenkins.service #only if failed earlier
sudo systemctl daemon-reload
sudo systemctl start jenkins
